---
// HeroGrainient — CSS gradient background (OGL WebGL deferred to future enhancement)
---

<div class="hero-grainient" data-grainient aria-hidden="true"></div>

<style>
  .hero-grainient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0.9;
    z-index: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 50%, rgba(0,75,28,0.8) 0%, transparent 70%),
      radial-gradient(ellipse 60% 80% at 80% 30%, rgba(20,60,20,0.6) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 70% 60%, rgba(0,50,15,0.5) 0%, transparent 60%),
      radial-gradient(ellipse 50% 50% at 50% 80%, rgba(10,40,10,0.4) 0%, transparent 70%);
  }

  .hero-grainient canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .grainient-active {
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grainient {
      opacity: 0.5;
    }
    .hero-grainient canvas {
      display: none;
    }
  }
</style>
