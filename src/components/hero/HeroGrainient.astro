---
// HeroGrainient — WebGL animated gradient (exact React Bits port)
---

<div class="grainient-container" data-grainient aria-hidden="true"></div>

<style>
  .grainient-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .grainient-container :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .grainient-container :global(canvas) {
      display: none;
    }
  }
</style>
