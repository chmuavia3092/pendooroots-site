---
// HeroGrainient — WebGL animated gradient background (OGL)
---

<div class="hero-grainient" data-grainient aria-hidden="true"></div>

<style>
  .hero-grainient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .hero-grainient :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .grainient-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grainient :global(canvas) {
      display: none;
    }
  }
</style>
