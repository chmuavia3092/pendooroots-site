---
/**
 * CartDrawer — slide-in shopping bag with localStorage cart
 */
---

<aside class="cart-drawer" data-cart-drawer role="dialog" aria-modal="true" aria-label="Shopping bag" hidden>
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel">
    <header class="cart-drawer__header">
      <h3 class="cart-drawer__title">Your Bag</h3>
      <button
        type="button"
        class="cart-drawer__close"
        data-cart-close
        aria-label="Close shopping bag"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </header>

    <div class="cart-drawer__items" data-cart-items>
      <p class="cart-drawer__empty">Your bag is empty.</p>
    </div>

    <footer class="cart-drawer__footer" data-cart-footer hidden>
      <div class="cart-drawer__row">
        <span>Subtotal</span>
        <span data-cart-subtotal>Rs.0</span>
      </div>
      <div class="cart-drawer__row cart-drawer__row--muted">
        <span>Shipping</span>
        <span data-cart-shipping>Calculated at checkout</span>
      </div>
      <a href="/checkout" class="btn btn--lg btn--block">Proceed to Checkout</a>
      <a href="/shop" class="btn btn--link btn--block" data-cart-close>Continue Shopping</a>
    </footer>
  </div>
</aside>

<style>
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
  }
  .cart-drawer[hidden] {
    display: none;
  }
  .cart-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 20, 20, 0.4);
    backdrop-filter: blur(2px);
    animation: fadeIn var(--duration-base) var(--ease-out-expo);
  }
  .cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(440px, 92vw);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xl);
    animation: slideIn var(--duration-slow) var(--ease-out-expo);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes slideIn {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-drawer__overlay,
    .cart-drawer__panel {
      animation: none;
    }
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .cart-drawer__title {
    font-family: var(--font-family-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }
  .cart-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    color: var(--color-text);
    transition: var(--transition-base);
  }
  .cart-drawer__close:hover {
    background: var(--color-surface-hover);
  }

  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4) var(--space-6);
  }
  .cart-drawer__empty {
    text-align: center;
    color: var(--color-text-secondary);
    padding: var(--space-16) 0;
    font-size: var(--text-md);
  }

  .cart-line {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .cart-line__image {
    width: 64px;
    height: 80px;
    object-fit: contain;
    background: var(--color-surface-soft);
    border-radius: var(--radius-sm);
  }
  .cart-line__name {
    font-family: var(--font-family-display);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }
  .cart-line__size {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 2px;
  }
  .cart-line__price {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
  }
  .cart-line__qty {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .cart-line__qty button {
    width: 26px;
    height: 26px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-md);
    line-height: 1;
    transition: var(--transition-base);
  }
  .cart-line__qty button:hover {
    background: var(--color-text);
    color: var(--color-text-inverse);
    border-color: var(--color-text);
  }
  .cart-line__qty span {
    min-width: 22px;
    text-align: center;
    font-size: var(--text-sm);
  }
  .cart-line__remove {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    align-self: start;
  }
  .cart-line__remove:hover {
    color: var(--color-danger);
  }

  .cart-drawer__footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-5) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cart-drawer__footer[hidden] {
    display: none;
  }
  .cart-drawer__row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-md);
  }
  .cart-drawer__row--muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>

<script>
  import { cart, type CartItem } from '@store/cart';
  import { getProductById, formatPrice } from '@data/products';

  const drawer = document.querySelector<HTMLElement>('[data-cart-drawer]');
  const itemsEl = document.querySelector<HTMLElement>('[data-cart-items]');
  const footerEl = document.querySelector<HTMLElement>('[data-cart-footer]');
  const subtotalEl = document.querySelector<HTMLElement>('[data-cart-subtotal]');
  const shippingEl = document.querySelector<HTMLElement>('[data-cart-shipping]');

  function render(): void {
    if (!drawer || !itemsEl || !footerEl || !subtotalEl || !shippingEl) return;
    const items = cart.getItems();
    if (items.length === 0) {
      itemsEl.innerHTML = '<p class="cart-drawer__empty">Your bag is empty.</p>';
      footerEl.hidden = true;
      return;
    }
    footerEl.hidden = false;
    itemsEl.innerHTML = items
      .map((it: CartItem) => {
        const product = getProductById(it.productId);
        if (!product) return '';
        const safeName = product.name.replace(/</g, '&lt;');
        return `
          <article class="cart-line">
            <img src="${product.image}" alt="${safeName}" class="cart-line__image" loading="lazy" />
            <div>
              <p class="cart-line__name">${safeName}</p>
              <p class="cart-line__size">${it.size}</p>
              <p class="cart-line__price">${formatPrice(product.price * it.quantity)}</p>
              <div class="cart-line__qty">
                <button data-cart-dec="${product.id}|${it.size}" aria-label="Decrease quantity">−</button>
                <span>${it.quantity}</span>
                <button data-cart-inc="${product.id}|${it.size}" aria-label="Increase quantity">+</button>
              </div>
            </div>
            <button class="cart-line__remove" data-cart-remove="${product.id}|${it.size}" aria-label="Remove ${safeName}">Remove</button>
          </article>`;
      })
      .join('');
    subtotalEl.textContent = cart.formatSubtotal();
    shippingEl.textContent = cart.formatShipping();
  }

  function open(): void {
    if (!drawer) return;
    drawer.hidden = false;
    document.body.style.overflow = 'hidden';
    const panel = drawer.querySelector<HTMLElement>('.cart-drawer__panel');
    panel?.focus();
  }

  function close(): void {
    if (!drawer) return;
    drawer.hidden = true;
    document.body.style.overflow = '';
  }

  // Wire open/close
  document
    .querySelectorAll<HTMLButtonElement>('[data-cart-open]')
    .forEach((btn) => btn.addEventListener('click', open));
  document
    .querySelectorAll<HTMLElement>('[data-cart-close]')
    .forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) close();
  });

  // Wire item events (delegation)
  if (itemsEl) {
    itemsEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const decKey = target.getAttribute('data-cart-dec');
      const incKey = target.getAttribute('data-cart-inc');
      const removeKey = target.getAttribute('data-cart-remove');
      if (decKey) {
        const [id, size] = decKey.split('|');
        const item = cart.getItems().find((it) => it.productId === Number(id) && it.size === size);
        if (item) cart.updateQuantity(Number(id), size, item.quantity - 1);
      } else if (incKey) {
        const [id, size] = incKey.split('|');
        const item = cart.getItems().find((it) => it.productId === Number(id) && it.size === size);
        if (item) cart.updateQuantity(Number(id), size, item.quantity + 1);
      } else if (removeKey) {
        const [id, size] = removeKey.split('|');
        cart.remove(Number(id), size);
      }
    });
  }

  // Subscribe + initial render
  cart.subscribe(render);
  render();
  window.dispatchEvent(new CustomEvent('cart:change'));
</script>
