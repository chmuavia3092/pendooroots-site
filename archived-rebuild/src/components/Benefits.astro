---
/**
 * Benefits — six reasons the LEMOO formula stands apart.
 */
import { LEMOO_BENEFITS } from '@data/site';

const ICON_PATHS: Record<string, string> = {
  leaf: 'M12 2C6 8 4 12 4 16a8 8 0 0 0 16 0c0-4-2-8-8-14z',
  droplet:
    'M12 2.5c4 5.5 7 9.5 7 13a7 7 0 1 1-14 0c0-3.5 3-7.5 7-13z',
  sparkle:
    'M12 2 14 9l7 2-7 2-2 7-2-7-7-2 7-2 2-7zM19 14l1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3z',
  hand: 'M7 11V6a2 2 0 0 1 4 0v5M11 11V4a2 2 0 0 1 4 0v7M15 11V6a2 2 0 0 1 4 0v8a8 8 0 0 1-8 8h-2a8 8 0 0 1-8-8v-2a2 2 0 0 1 4 0',
  shield:
    'M12 2 4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3z',
  bottle: 'M9 2h6v3l1 3v12a3 3 0 0 1-3 3h-2a3 3 0 0 1-3-3V8l1-3V2z',
};
---

<section class="benefits section section--alt" id="benefits">
  <div class="container">
    <header class="benefits__head reveal">
      <p class="eyebrow">Why LEMOO</p>
      <h2 class="benefits__title">Six reasons it stands apart.</h2>
      <p class="section-lede">
        We did not set out to build a prettier dish wash. We set out to build
        a better one — and let the design follow.
      </p>
    </header>

    <ul class="benefits__grid">
      {
        LEMOO_BENEFITS.map((b, i) => (
          <li class="benefit reveal" style={`transition-delay: ${i * 60}ms`}>
            <span class="benefit__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d={ICON_PATHS[b.icon] ?? ICON_PATHS.sparkle} />
              </svg>
            </span>
            <h3 class="benefit__title">{b.title}</h3>
            <p class="benefit__desc">{b.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .benefits__head {
    max-width: 64ch;
    margin-bottom: var(--space-12);
  }
  .benefits__title {
    margin-bottom: var(--space-4);
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-1);
    background: var(--color-rule);
    border: 1px solid var(--color-border);
  }
  .benefit {
    background: var(--color-surface);
    padding: var(--space-10) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .benefit__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--color-bg-alt);
    color: var(--color-primary);
  }
  .benefit__title {
    font-family: var(--font-family-display);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }
  .benefit__desc {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  @media (max-width: 1024px) {
    .benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .benefits__grid {
      grid-template-columns: 1fr;
    }
    .benefit {
      padding: var(--space-6);
    }
  }
</style>
