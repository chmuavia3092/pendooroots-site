---
/**
 * Header — top navigation, cart, mobile menu
 */
import { SITE, PRIMARY_NAV } from '@data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="siteHeader">
  <div class="container container--wide site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand__mark" aria-hidden="true">P</span>
      <span class="brand__word">{SITE.name}</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul class="primary-nav__list">
        {
          PRIMARY_NAV.map((item) => {
            const isActive =
              item.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class={`primary-nav__link${isActive ? ' is-active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/shop" class="icon-btn" aria-label="Search products">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </a>
      <a href="/wishlist" class="icon-btn icon-btn--badge" aria-label="View wishlist">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
        <span class="icon-btn__badge" data-wishlist-count>0</span>
      </a>
      <button
        type="button"
        class="icon-btn icon-btn--badge"
        data-cart-open
        aria-label="Open shopping bag"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
          <line x1="3" y1="6" x2="21" y2="6" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
        <span class="icon-btn__badge" data-cart-count>0</span>
      </button>
      <a href="/shop/lemoo-washer" class="btn btn--sm site-header__cta">Shop LEMOO</a>
    </div>

    <button
      type="button"
      class="hamburger"
      data-mobile-toggle
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" data-mobile-menu hidden>
    <ul class="mobile-menu__list">
      {
        PRIMARY_NAV.map((item) => (
          <li>
            <a href={item.href} class="mobile-menu__link">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-navbar);
    background: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition: background var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-base) var(--ease-out-expo);
  }

  .site-header.is-scrolled {
    background: var(--color-bg-elevated);
    border-bottom-color: var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    height: var(--space-nav-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-family-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    color: var(--color-text);
  }

  .brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-family: var(--font-family-display);
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
  }

  .primary-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .primary-nav__link {
    position: relative;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    padding-block: var(--space-2);
    transition: color var(--duration-base) var(--ease-out-expo);
  }

  .primary-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .primary-nav__link:hover,
  .primary-nav__link.is-active {
    color: var(--color-text);
  }

  .primary-nav__link.is-active::after,
  .primary-nav__link:hover::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    color: var(--color-text);
    transition: var(--transition-base);
  }

  .icon-btn:hover {
    background: var(--color-surface-hover);
  }

  .icon-btn__badge {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    line-height: 18px;
    text-align: center;
    letter-spacing: 0;
  }

  .site-header__cta {
    display: inline-flex;
  }

  .btn--sm {
    --btn-padding-y: var(--space-2);
    --btn-padding-x: var(--space-5);
    font-size: var(--text-xs);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-text);
    transition: var(--transition-base);
  }
  .hamburger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-6) var(--container-padding);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .mobile-menu__link {
    display: block;
    font-family: var(--font-family-display);
    font-size: var(--text-2xl);
    color: var(--color-text);
  }

  @media (max-width: 1024px) {
    .primary-nav {
      display: none;
    }
    .site-header__cta {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .site-header__inner {
      gap: var(--space-3);
    }
    .hamburger {
      display: inline-flex;
    }
    .icon-btn--badge:nth-of-type(2) {
      display: none;
    }
  }
</style>

<script>
  // Header behaviors: mobile menu + scroll state
  const header = document.getElementById('siteHeader');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
    });
    menu.addEventListener('click', (e) => {
      if (e.target instanceof HTMLAnchorElement) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      }
    });
  }

  // Wishlist count sync
  try {
    const ids = JSON.parse(localStorage.getItem('pr_wishlist') || '[]');
    const badge = document.querySelector<HTMLElement>('[data-wishlist-count]');
    if (badge && Array.isArray(ids)) badge.textContent = String(ids.length);
  } catch {}

  // Cart count sync (from localStorage on every page)
  function syncCartBadge() {
    try {
      const items = JSON.parse(localStorage.getItem('pr_cart') || '[]');
      const count = Array.isArray(items)
        ? items.reduce(
            (s: number, it: { quantity?: number }) => s + (it.quantity ?? 0),
            0,
          )
        : 0;
      document
        .querySelectorAll<HTMLElement>('[data-cart-count]')
        .forEach((el) => (el.textContent = String(count)));
    } catch {}
  }
  syncCartBadge();
  window.addEventListener('storage', syncCartBadge);
  window.addEventListener('cart:change', syncCartBadge);
</script>
