---
/**
 * Footer — site-wide footer with editorial sections
 */
import { SITE, FOOTER_NAV } from '@data/site';

const year = new Date().getFullYear();
const copyrightYear = year > SITE.copyrightYear ? `${SITE.copyrightYear}–${year}` : String(SITE.copyrightYear);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="site-footer__eyebrow">{SITE.name}</p>
        <p class="site-footer__statement">
          {SITE.tagline} Botanical care, crafted honestly in Pakistan.
        </p>
        <form class="newsletter" data-newsletter>
          <label class="newsletter__label" for="newsletter-email">
            Letters from the workshop
          </label>
          <div class="newsletter__row">
            <input
              type="email"
              id="newsletter-email"
              name="email"
              required
              placeholder="Your email"
              autocomplete="email"
            />
            <button type="submit" class="btn btn--accent">Subscribe</button>
          </div>
          <p class="newsletter__status" data-newsletter-status aria-live="polite"></p>
        </form>
      </div>

      <div class="site-footer__columns">
        <div class="site-footer__col">
          <h4>Shop</h4>
          <ul>
            {
              FOOTER_NAV.shop.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="site-footer__col">
          <h4>Brand</h4>
          <ul>
            {
              FOOTER_NAV.brand.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="site-footer__col">
          <h4>Support</h4>
          <ul>
            {
              FOOTER_NAV.support.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="site-footer__col">
          <h4>Contact</h4>
          <ul>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li>
              <a
                href={`https://wa.me/${SITE.whatsapp}`}
                target="_blank"
                rel="noopener"
              >
                WhatsApp: {SITE.whatsappDisplay}
              </a>
            </li>
            <li>{SITE.addressLine1}</li>
          </ul>
          <div class="site-footer__social">
            <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            </a>
            <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
              </svg>
            </a>
            <a href={SITE.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.93a8.16 8.16 0 0 0 4.77 1.52V6.69h-1.84z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>
        © {copyrightYear} {SITE.name}. All rights reserved.
      </p>
      <p>
        Crafted with care in {SITE.addressLine1.replace(', Pakistan', '')}.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    color: var(--color-text-inverse);
    padding-block: var(--space-24) var(--space-8);
    margin-top: var(--space-32);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    gap: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-footer__eyebrow {
    font-family: var(--font-family-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-widest);
    margin-bottom: var(--space-3);
  }

  .site-footer__statement {
    font-family: var(--font-family-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-8);
    max-width: 32ch;
  }

  .newsletter__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: rgba(253, 250, 242, 0.6);
    margin-bottom: var(--space-3);
  }

  .newsletter__row {
    display: flex;
    gap: var(--space-2);
    align-items: stretch;
  }

  .newsletter input {
    flex: 1;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(253, 250, 242, 0.4);
    color: var(--color-text-inverse);
    padding: var(--space-3) 0;
    font-size: var(--text-md);
    transition: border-color var(--duration-base) var(--ease-out-expo);
  }

  .newsletter input::placeholder {
    color: rgba(253, 250, 242, 0.5);
  }

  .newsletter input:focus {
    outline: none;
    border-bottom-color: var(--color-accent-light);
  }

  .newsletter .btn--accent {
    --btn-bg: var(--color-accent-light);
    --btn-color: var(--color-primary-dark);
    --btn-border: var(--color-accent-light);
    --btn-hover-bg: var(--color-text-inverse);
    --btn-hover-color: var(--color-primary-dark);
  }

  .newsletter__status {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: rgba(253, 250, 242, 0.7);
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-10);
  }

  .site-footer__col h4 {
    font-family: var(--font-family-ui);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: rgba(253, 250, 242, 0.6);
    margin-bottom: var(--space-4);
  }

  .site-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__col a {
    color: var(--color-text-inverse);
    font-size: var(--text-md);
    opacity: 0.85;
    transition: opacity var(--duration-base) var(--ease-out-expo);
  }

  .site-footer__col a:hover {
    opacity: 1;
    color: var(--color-accent-light);
  }

  .site-footer__col li:not(:has(a)) {
    font-size: var(--text-md);
    opacity: 0.7;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(253, 250, 242, 0.2);
    opacity: 0.85;
  }

  .site-footer__social a:hover {
    border-color: var(--color-accent-light);
    color: var(--color-accent-light);
    opacity: 1;
  }

  .site-footer__bottom {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-sm);
    color: rgba(253, 250, 242, 0.55);
  }

  @media (max-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
    .site-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding-block: var(--space-16) var(--space-6);
    }
    .site-footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const status = document.querySelector<HTMLElement>('[data-newsletter-status]');
  if (form && status) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      if (!email) {
        status.textContent = 'Please enter a valid email.';
        return;
      }
      status.textContent = 'Thank you. Watch for our next letter.';
      form.reset();
    });
  }
</script>
