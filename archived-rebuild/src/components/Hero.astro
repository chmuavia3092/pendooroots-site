---
/**
 * Hero — cinematic, product-first first viewport.
 */
import { SITE } from '@data/site';
import { getProductById } from '@data/products';

const hero = getProductById(1)!;
---

<section class="hero" aria-label="LEMOO Washer — hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__container">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow reveal">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        New · Botanical Dish Wash
      </p>
      <h1 class="hero__title reveal reveal--delay-1">
        {SITE.heroHeadline}
      </h1>
      <p class="hero__lede reveal reveal--delay-2">
        {SITE.heroSubhead}
      </p>
      <div class="hero__actions reveal reveal--delay-3">
        <a href="/shop/lemoo-washer" class="btn btn--lg">Shop LEMOO — Rs.320</a>
        <a href="#story" class="btn btn--lg btn--ghost">Read the story</a>
      </div>
      <ul class="hero__meta reveal reveal--delay-3" aria-label="Product highlights">
        <li>
          <span class="hero__meta-value">4.9</span>
          <span class="hero__meta-label">Rating</span>
        </li>
        <li>
          <span class="hero__meta-value">892</span>
          <span class="hero__meta-label">Reviews</span>
        </li>
        <li>
          <span class="hero__meta-value">100%</span>
          <span class="hero__meta-label">Botanical</span>
        </li>
      </ul>
    </div>

    <div class="hero__visual reveal reveal--delay-1">
      <div class="hero__visual-frame">
        <img
          src={hero.image}
          alt="LEMOO Washer — PENDOOROOTS"
          class="hero__bottle"
          width="640"
          height="800"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero__visual-shine" aria-hidden="true"></div>
      </div>
      <p class="hero__caption">
        <span>LEMOO Washer</span>
        <span>{hero.variant}</span>
      </p>
    </div>
  </div>

  <div class="hero__marquee" aria-hidden="true">
    <div class="hero__marquee-track">
      {Array.from({ length: 2 }).map(() => (
        <div class="hero__marquee-row">
          <span>Make Every Dish Shine</span>
          <span>·</span>
          <span>Botanical Surfactants</span>
          <span>·</span>
          <span>Skin Friendly</span>
          <span>·</span>
          <span>Made in Pakistan</span>
          <span>·</span>
          <span>Perfect Shine</span>
          <span>·</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 75% 30%, var(--color-bg-alt) 0%, transparent 55%),
      linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
  }

  .hero__container {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
    min-height: min(720px, 80vh);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
  }
  .hero__eyebrow-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .hero__title {
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    letter-spacing: var(--tracking-tighter);
    line-height: 0.98;
  }
  .hero__title::first-line {
    font-style: italic;
    font-weight: var(--font-weight-regular);
  }

  .hero__lede {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 48ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__meta {
    display: flex;
    gap: var(--space-10);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }
  .hero__meta li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .hero__meta-value {
    font-family: var(--font-family-display);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }
  .hero__meta-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__visual-frame {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(ellipse at 50% 35%, var(--color-surface) 0%, var(--color-surface-soft) 70%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .hero__visual-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.7) 0%, transparent 40%),
      radial-gradient(circle at 80% 80%, rgba(107, 122, 75, 0.1) 0%, transparent 50%);
  }
  .hero__bottle {
    position: relative;
    z-index: 1;
    width: 78%;
    max-height: 88%;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgba(20, 20, 20, 0.18));
    animation: heroFloat 7s ease-in-out infinite;
  }
  @keyframes heroFloat {
    0%, 100% { transform: translateY(0) rotate(-0.6deg); }
    50% { transform: translateY(-12px) rotate(0.4deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__bottle {
      animation: none;
    }
  }
  .hero__visual-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.5) 50%, transparent 65%);
    transform: translateX(-100%);
    animation: shine 9s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes shine {
    0%, 60% { transform: translateX(-100%); }
    80%, 100% { transform: translateX(100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__visual-shine {
      animation: none;
    }
  }
  .hero__caption {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-6);
    right: var(--space-6);
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
  }

  .hero__marquee {
    margin-top: var(--space-16);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-rule);
    overflow: hidden;
  }
  .hero__marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 50s linear infinite;
  }
  .hero__marquee-row {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-right: var(--space-6);
    font-family: var(--font-family-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-secondary);
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__marquee-track {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .hero__container {
      grid-template-columns: 1fr;
      gap: var(--space-12);
      min-height: auto;
    }
    .hero__visual-frame {
      max-width: 380px;
      margin-inline: auto;
    }
    .hero__visual {
      order: -1;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-10);
    }
    .hero__meta {
      gap: var(--space-6);
    }
    .hero__marquee-row {
      font-size: var(--text-xl);
    }
  }
</style>
