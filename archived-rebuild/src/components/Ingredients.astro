---
/**
 * Ingredients — full LEMOO ingredient breakdown.
 */
import { LEMOO_INGREDIENTS } from '@data/site';
---

<section class="ingredients section section--soft" id="ingredients">
  <div class="container">
    <div class="ingredients__head reveal">
      <p class="eyebrow">Inside the bottle</p>
      <h2 class="ingredients__title">Five ingredients. Nothing to hide.</h2>
      <p class="section-lede">
        Most dish washes list 12+ ingredients. LEMOO is five. Each one earns
        its place — and we explain exactly why it is there.
      </p>
    </div>

    <ol class="ingredients__list">
      {
        LEMOO_INGREDIENTS.map((ing, i) => (
          <li class="ingredient reveal" style={`transition-delay: ${i * 80}ms`}>
            <span class="ingredient__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="ingredient__name">{ing.name}</h3>
              <p class="ingredient__role">{ing.role}</p>
              <p class="ingredient__desc">{ing.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ingredients__head {
    max-width: 60ch;
    margin-bottom: var(--space-12);
  }
  .ingredients__title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-4);
  }
  .ingredients__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-10) var(--space-12);
  }
  .ingredient {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: start;
  }
  .ingredient__num {
    font-family: var(--font-family-display);
    font-size: var(--text-2xl);
    color: var(--color-accent);
    line-height: 1;
    padding-top: var(--space-1);
  }
  .ingredient__name {
    font-family: var(--font-family-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-1);
  }
  .ingredient__role {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .ingredient__desc {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }
  @media (max-width: 768px) {
    .ingredients__list {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
