---
/**
 * ProductCard — reusable product card
 */
import { formatPrice, type Product } from '@data/products';

interface Props {
  product: Product;
  variant?: 'default' | 'compact';
}

const { product, variant = 'default' } = Astro.props;
const hasDiscount = product.oldPrice !== null && product.oldPrice > product.price;
const discount = hasDiscount
  ? Math.round(((product.oldPrice! - product.price) / product.oldPrice!) * 100)
  : 0;
---

<article class={`product-card product-card--${variant}`} data-product-id={product.id}>
  <a class="product-card__media" href={`/shop/${product.slug}`} aria-label={`View ${product.name}`}>
    {
      product.badge && (
        <span class={`product-card__badge${product.badge === 'Hero Product' ? ' product-card__badge--hero' : ''}`}>
          {product.badge}
        </span>
      )
    }
    <img
      src={product.image}
      alt={product.name}
      loading="lazy"
      decoding="async"
      width="400"
      height="500"
    />
    <div class="product-card__quickadd" data-quickadd={product.id}>
      <span>Add to bag</span>
    </div>
  </a>

  <div class="product-card__body">
    <p class="product-card__category">{product.category}</p>
    <h3 class="product-card__title">
      <a href={`/shop/${product.slug}`}>{product.name}</a>
    </h3>
    <p class="product-card__variant">{product.variant}</p>
    <div class="product-card__row">
      <p class="product-card__price">
        {formatPrice(product.price)}
        {hasDiscount && <span class="product-card__price-old">{formatPrice(product.oldPrice!)}</span>}
      </p>
      {
        product.rating && (
          <p class="product-card__rating" aria-label={`Rated ${product.rating} out of 5`}>
            <span class="product-card__stars" style={`--rating: ${product.rating}`}>★★★★★</span>
            <span class="product-card__reviews">({product.reviews})</span>
          </p>
        )
      }
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    background: var(--color-surface-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: var(--transition-base);
  }
  .product-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(20, 20, 20, 0.08));
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out-expo);
    pointer-events: none;
  }
  .product-card__media:hover::after {
    opacity: 1;
  }
  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-6);
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }
  .product-card__media:hover img {
    transform: scale(1.04);
  }
  .product-card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
  }
  .product-card__badge--hero {
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }
  .product-card__quickadd {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%) translateY(8px);
    background: var(--color-text);
    color: var(--color-text-inverse);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-pill);
    opacity: 0;
    transition: var(--transition-base);
    cursor: pointer;
  }
  .product-card__media:hover .product-card__quickadd {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .product-card__category {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .product-card__title {
    font-family: var(--font-family-display);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }
  .product-card__title a {
    transition: color var(--duration-base) var(--ease-out-expo);
  }
  .product-card__title a:hover {
    color: var(--color-accent);
  }
  .product-card__variant {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .product-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .product-card__price {
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }
  .product-card__price-old {
    margin-left: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: line-through;
    font-weight: var(--font-weight-regular);
  }
  .product-card__rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .product-card__stars {
    color: var(--color-star);
    font-size: var(--text-sm);
    letter-spacing: 1px;
  }

  .product-card--compact .product-card__media {
    aspect-ratio: 1;
  }
</style>
